# Copy to /etc/seawarden/seawarden.env (mode 0600). Placeholders only.

SEAWARDEN_ROOT=/mnt/seawarden_backups
SSH_KEY=/root/.seawarden-backup-key
SSH_USER=your_ssh_user
SSH_HOST=origin.example.com
SITE_PATH=/var/www/html
RETENTION=24
LOCK_STALE_SECONDS=2700
RSYNC_BWLIMIT=50000
EXCLUDE_FILE=/etc/seawarden/rsync-excludes.txt
GPG_PASSPHRASE_FILE=/root/.seawarden-gpg-passphrase
STATUS_DIR=/mnt/seawarden_backups/status

# production | staging | development — passed as argv to the script
# ORIGIN_STACK=wordpress   # wordpress | laravel | symfony | node
# DB_DUMP_CMD is optional override; see examples/
